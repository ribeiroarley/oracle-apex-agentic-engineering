# ==============================================================================
# Oracle Database 23ai Free - Laboratório SQLcl MCP Server (Modelo de Configuração)
# ==============================================================================
# Copie este arquivo para .env.lab antes de iniciar o container:
#   cp .env.lab.example .env.lab
# ==============================================================================

# Nome do Projeto Docker Compose
COMPOSE_PROJECT_NAME=oracle-apex-mcp-lab

# Senha administrativa do SYS/SYSTEM
ORACLE_PWD=OracleLab2026!

# Senha do schema de dados de exemplo HR
HR_PWD=HrSchema2026!

# Senha do usuário de IA com governança de Menor Privilégio (Read-Only)
MCP_RO_PWD=McpReadOnly2026!

# Nome da PDB padrão do Oracle 23ai Free
ORACLE_PDB=FREEPDB1

# Porta mapeada no host para conexão SQLcl / Listener
ORACLE_PORT=1521
